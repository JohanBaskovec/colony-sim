tool.zone_remove.description = Takes the area you drag out of the zones; the rest of each zone stays
tool.gather_zone.description = Settlers gather the resources you pick in it: wood, wild food, branches, twigs, grass and other fibres, stones
tool.stockpile.description = Settlers store the items you allow in it
tool.mine.description = Settlers dig out the marked rock and bring back stone, or the marked earth (galleries into hills, dugouts), faster with a digging stick; a ceiling needs rock, a wall or a prop within 2 tiles
tool.dig_ramp.description = Mark a bank of earth one level high: settlers cut a ramp into it, to walk up to the ground behind
tool.dig_down.description = Settlers dig the marked ground and the earth under it out: the hole slopes up to where its digger stood, the way into a cellar
tool.chop.description = Settlers fell the marked trees, away from buildings, and the wood lies along the fallen trunk
tool.harvest.description = Settlers take what the marked plants bear (fruit, leaves, roots dug up, grass cut); the plants stay where they grow back
tool.uproot.description = Settlers pull the marked plants up (not trees): what they bear is harvested first
tool.cancel.description = Removes the orders in the area you drag
tool.forbid = Forbid
tool.forbid.description = Settlers leave alone what lies in the area you drag (but grass): nothing picked up, eaten, used, taken apart or felled, no way through doors and ladders
tool.allow = Allow
tool.allow.description = Settlers may use again what is in the area you drag
tool.deconstruct.description = Settlers take the marked beds, walls, doors and roofs apart (a roof is marked on its level, above the walls) and get half of the materials back

