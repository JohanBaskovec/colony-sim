# HUD
# {0} = day of the season, {1} = season name, {2} = year, {3} = hours (00-23), {4} = minutes
hud.date = {1} {0}, year {2} · {3}:{4}
# {0} = speed multiplier
hud.speed = Speed: {0}×
hud.paused = Paused
# {0} = language name
hud.language = Language: {0}
# {0} = movement keys (e.g. WASD, adapted to the keyboard layout)
hud.help.camera = {0}/Arrows: move · Wheel: zoom · Middle/right drag: pan
hud.help.game = Left click/drag: select · Space: pause · 1-3: speed · L: language · F3: debug · Esc: quit
# {0}, {1}, {2}, {3} = keys of the chop, mine, harvest and cancel tools
hud.help.orders = {0}: chop trees · {1}: mine rock · {2}: harvest · {3}: cancel orders
# {0} = key of the stockpile zone tool, {1} = key of the work priorities grid
hud.help.manage = {0}: stockpile zones (click a zone: its settings) · {1}: work priorities
# {0} = tool name
hud.tool = Tool: {0} · Left click/drag: apply · Esc: back
# {0} = tool name (stockpile zone tool: first line, help on the second line)
hud.tool.name = Tool: {0}
hud.tool.stockpile_help = Drag: create, or extend the selected zone · Shift+drag: remove · Esc: back

# Tile inspector. {0}, {1} = tile coordinates
hud.tile.position = Tile {0}, {1}
hud.tile.terrain = Terrain: {0}
hud.tile.rock = Rock wall: {0}
# {0} = plant name, {1} = growth percentage
hud.tile.plant = Plant: {0} ({1}% grown)
hud.tile.move_cost = Movement cost: ×{0}
hud.tile.impassable = Impassable
# {0} = item name, {1} = number of items, {2} = total weight (e.g. 21 kg)
hud.tile.items = Items: {0} ×{1} ({2})
# {0} = order name (e.g. Chop trees)
hud.tile.designation = Order: {0}
# {0} = order name, {1} = percentage of the work done
hud.tile.designation_progress = Order: {0} ({1}% done)
# {0} = stockpile name (e.g. Stockpile 2)
hud.tile.stockpile = Zone: {0}
# Items on a tile or carried. {0} = quality grade, {1} = hit points,
# {2} = maximum hit points, {3} = hit points in percent (e.g. 75%)
hud.item_condition = Quality: {0} · Hit points: {1}/{2} ({3})

# Debug overlay (F3)
hud.debug.fps = FPS: {0}
