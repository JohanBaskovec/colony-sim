tool.stockpile = Zone de stockage
tool.gather_zone = Zone de récolte
tool.gather_remove = Retirer des zones de récolte et d’arrachage
tool.uproot_zone = Zone d’arrachage
tool.uproot_zone.description = Les colons y arrachent les plantes choisies, les nouvelles pousses aussi ; les arbres sont épargnés. Les zones de stockage font de même avec toutes les plantes
tool.stockpile_remove = Retirer des zones de stockage
tool.zone_remove.description = Retire la surface glissée des zones ; le reste de chaque zone est conservé
tool.gather_zone.description = Les colons y récoltent les ressources choisies : bois, nourriture sauvage, branches, brindilles, herbe et autres fibres, pierres
tool.stockpile.description = Les colons y rangent les objets autorisés
tool.mine.description = Les colons creusent la roche marquée et en rapportent la pierre, ou la terre, le sable, le gravier ou l’argile marqués (galeries dans les collines, abris enterrés), plus vite avec un bâton à fouir ; un plafond a besoin de roche, d’un mur ou d’un étai à 2 cases au plus ; une goutte bleue signale où l’eau entrerait (sous la nappe, au bord d’un lac)
tool.dig_down.description = Les colons creusent le sol marqué et la terre en dessous : le trou remonte en pente là où se tenait le creuseur, l’entrée d’une cave ; une goutte bleue signale où l’eau entrerait (sous la nappe, au bord d’un lac)
tool.chop.description = Les colons abattent les arbres marqués, loin des constructions, et le bois reste le long du tronc tombé
tool.harvest.description = Les colons récoltent ce que portent les plantes marquées (fruits, feuilles, racines déterrées, herbe coupée) ; les plantes restent là où elles repoussent
tool.harvest_ripe.description = Les colons ne prennent ce que portent les plantes marquées qu’une fois leur pleine maturité atteinte (tous les fruits mûrs, toutes les brassées poussées) ; d’ici là, l’ordre attend sur la plante
tool.uproot.description = Les colons arrachent les plantes marquées (pas les arbres) : ce qu’elles portent est récolté d’abord
tool.dig_ramp.description = Marquez un talus de terre d’un niveau : les colons y taillent une rampe pour monter sur le sol derrière ; une goutte bleue signale où l’eau entrerait (sous la nappe, au bord d’un lac)
tool.cancel.description = Retire les ordres de la zone glissée
tool.forbid = Interdire
tool.forbid.description = Les colons laissent tranquille ce qui se trouve dans la zone glissée (sauf l’herbe) : rien de ramassé, mangé, utilisé, démonté ni abattu, et ni porte ni échelle franchie
tool.allow = Autoriser
tool.allow.description = Les colons peuvent de nouveau se servir de ce qui se trouve dans la zone glissée
tool.deconstruct.description = Les colons démontent les lits, murs, portes et toits marqués (un toit se marque sur son niveau, au-dessus des murs) et récupèrent la moitié des matériaux

