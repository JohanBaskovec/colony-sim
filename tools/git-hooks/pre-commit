#!/bin/sh
# Refuses a commit whose staged C files are not clang-format clean (it checks
# the staged content, not the working tree). Enable it once per clone:
#   git config core.hooksPath tools/git-hooks

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format not found, format check skipped" >&2
    exit 0
fi

status=0
for file in $(git diff --cached --name-only --diff-filter=ACM -- '*.c' '*.h'); do
    # The trailing "x" keeps the final newline out of the comparison's way.
    staged=$(git show ":$file"; echo x)
    formatted=$(git show ":$file" | clang-format --assume-filename="$file"; echo x)
    if [ "$formatted" != "$staged" ]; then
        echo "pre-commit: $file is not clang-format clean" >&2
        status=1
    fi
done
if [ "$status" -ne 0 ]; then
    echo "pre-commit: run 'clang-format -i' on these files, stage them and commit again" >&2
fi
exit $status
