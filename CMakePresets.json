{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Game + tests, debug symbols",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized game + tests",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug + sanitizers",
      "description": "Game + tests with AddressSanitizer and UBSan, warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "COLONY_ENABLE_SANITIZERS": "ON",
        "COLONY_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "profile",
      "displayName": "Optimized + debug symbols (profiling)",
      "description": "As release, with debug symbols and frame pointers so that perf can follow the call stacks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-g -fno-omit-frame-pointer"
      }
    },
    {
      "name": "headless",
      "displayName": "Core + tests only (no SDL)",
      "description": "Fast configuration for simulation work and CI: no SDL download, sanitizers, warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "COLONY_BUILD_GAME": "OFF",
        "COLONY_ENABLE_SANITIZERS": "ON",
        "COLONY_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } }
  ]
}
